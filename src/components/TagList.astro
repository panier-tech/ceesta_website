---
import { sitePath, tagSlug } from '../lib/articles';
interface Props { tags: string[] }
const { tags } = Astro.props;
---
{tags.length > 0 && <ul class="tag-list" aria-label="タグ">
	{tags.map((tag) => <li><a href={sitePath(`/tags/${tagSlug(tag)}/`)}><svg class="tag-icon" aria-hidden="true" viewBox="0 0 16 16"><path d="M2 2h5l7 7-5 5-7-7V2Z" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="5" cy="5" r=".8" fill="currentColor"/></svg>{tag}</a></li>)}
</ul>}
